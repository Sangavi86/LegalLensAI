# ==============================================================================
# LegalLens AI – Master Environment Template (.env.example)
# Copy this file to .env and populate your credentials. Never commit .env to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Gateway (Node.js Express)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# JWT & Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super-secret-refresh-key-replace-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

# Microservice Communications
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_API_KEY=internal-service-token-dev-secret

# Redis Cluster / Standalone (Optional in Phase 1, required in Phase 2)
REDIS_URL=redis://localhost:6379

# MongoDB Atlas (Required in Phase 2)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/legallens?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. AI Intelligence Engine (Python FastAPI)
# ------------------------------------------------------------------------------
FASTAPI_ENV=development
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0
AI_ENGINE_SECRET=internal-service-token-dev-secret

# Configurable LLM Providers & Model Routing
# Provider options: google, openai, anthropic, mock
DEFAULT_LLM_PROVIDER=google

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Task-Specific Model Identifiers (Configurable)
LLM_MODEL_EXTRACTION=gemini-2.5-flash
LLM_MODEL_RESEARCH=gemini-2.5-flash
LLM_MODEL_VERIFICATION=gemini-2.5-pro
LLM_MODEL_REASONING=gemini-2.5-pro

# Optional External Providers (fallback / alternative routing)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Knowledge Base & Vector Stores (Phase 2+)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password

# ------------------------------------------------------------------------------
# 3. Frontend Web Application (React Vite)
# ------------------------------------------------------------------------------
VITE_API_GATEWAY_URL=http://localhost:5000
VITE_AI_ENGINE_URL=http://localhost:8000
VITE_DEFAULT_JURISDICTION=IN
