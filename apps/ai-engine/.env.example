FASTAPI_ENV=development
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0
AI_ENGINE_SECRET=internal-service-token-dev-secret

# Configurable LLM Provider
DEFAULT_LLM_PROVIDER=mock

# Google Gemini API Key (when using DEFAULT_LLM_PROVIDER=google)
GEMINI_API_KEY=your_gemini_api_key_here

# Task-Specific Configurable Model Identifiers
LLM_MODEL_EXTRACTION=gemini-2.5-flash
LLM_MODEL_RESEARCH=gemini-2.5-flash
LLM_MODEL_VERIFICATION=gemini-2.5-pro
LLM_MODEL_REASONING=gemini-2.5-pro
